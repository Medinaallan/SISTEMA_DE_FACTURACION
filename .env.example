# Variables de entorno para ERP Honduras

# Configuración de la base de datos (opcional)
DATABASE_URL="file:./erp-honduras.db"

# Configuración de Firebase (opcional para sincronización)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Configuración de Supabase (opcional para sincronización)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# API externa personalizada (opcional)
NEXT_PUBLIC_API_ENDPOINT=""
NEXT_PUBLIC_API_KEY=""

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME="ERP Honduras"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_COMPANY_NAME="Mi Empresa"

# Modo de desarrollo
NODE_ENV="development"
